<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GMSApiKey</key>
	<string>$(GOOGLE_MAPS_API_KEY)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Matchmake</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Matchmake</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Matchmake usa la cámara para escanear códigos QR de check-in y para tomar fotos de verificación de identidad.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Matchmake accede a tus fotos para que elijas una imagen de perfil.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Matchmake usa tu ubicación para encontrar canchas y partidos cercanos.</string>
	<!-- Deep links: Mercado Pago vuelve a la app con sportsconnect://payment/* -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.matchmake.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sportsconnect</string>
			</array>
		</dict>
		<!-- TODO(iOS): Google Sign-In. Añade aquí un segundo dict con el
		     REVERSED_CLIENT_ID del cliente OAuth iOS (ej. com.googleusercontent.apps.XXX)
		     una vez configurado GOOGLE_IOS_CLIENT_ID en .env / Google Cloud. -->
	</array>
	<!-- Esquemas que la app puede abrir con url_launcher -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>mailto</string>
		<string>tel</string>
		<string>https</string>
		<string>maps</string>
		<string>comgooglemaps</string>
	</array>
	<!-- Push (OneSignal) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- No usa criptografía sujeta a export compliance → evita el prompt en TestFlight -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
