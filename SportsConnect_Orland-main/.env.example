# Copia este archivo a .env y completa los valores reales.
# .env está gitignored — nunca commitear credenciales.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

GOOGLE_ANDROID_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=xxx.apps.googleusercontent.com

GOOGLE_MAPS_API_KEY=your-maps-key

MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_TEST_PUBLIC_KEY=TEST-xxx
MP_TEST_ACCESS_TOKEN=TEST-xxx
MP_USE_SANDBOX=true

ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=
